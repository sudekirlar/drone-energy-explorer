__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/

# ---- IDE / OS ---------------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- secrets ----------------------------------------------------------
.env
.streamlit/secrets.toml
